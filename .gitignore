# Secrets: real values live in .env, which must never be committed
.env
.env.*
!.env.example

# Virtual environments
.venv/
venv/
env/
ENV/

# Byte-compiled / cached files
__pycache__/
*.py[cod]
*$py.class

# Test, coverage and type-checker caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Packaging / build output
build/
dist/
*.egg-info/

# OS / editor files
.DS_Store
Thumbs.db
.idea/
