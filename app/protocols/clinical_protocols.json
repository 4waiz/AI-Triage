{
  "version": "2025-10-09",
  "source": "RightCare Ground Truth Demo v2",
  "esi": {
    "levels": [
      {
        "id": "ESI-1",
        "name": "Immediate / Life-threatening",
        "criteria": [
          "Need immediate life-saving intervention",
          "Airway compromise, apnea, pulseless",
          "Unresponsive or seizure with airway risk"
        ],
        "route": "ED",
        "urgency": "Critical"
      },
      {
        "id": "ESI-2",
        "name": "Emergent / High risk",
        "criteria": [
          "High-risk situation or severe pain/distress (≥7/10)",
          "Acute confusion, lethargy, or disorientation",
          "Infant < 3 months with fever"
        ],
        "route": "ED",
        "urgency": "High"
      },
      {
        "id": "ESI-3",
        "name": "Urgent but stable",
        "criteria": [
          "Multiple resources expected (e.g. labs + imaging)",
          "Vitals stable"
        ],
        "route": "Outpatient",
        "urgency": "Moderate"
      },
      {
        "id": "ESI-4",
        "name": "Single resource",
        "criteria": [
          "Minor procedures or X-rays",
          "Stable vitals"
        ],
        "route": "Outpatient",
        "urgency": "Low"
      },
      {
        "id": "ESI-5",
        "name": "No resources required",
        "criteria": [
          "Exam and advice only"
        ],
        "route": "Self-Care",
        "urgency": "Minimal"
      }
    ]
  },

  "symptom_to_esi": {
    "severe chest pain": "ESI-2",
    "shortness of breath": "ESI-2",
    "fainting": "ESI-1",
    "i lost my hand": "ESI-1",
    "i cant walk": "ESI-2",
    "fever": "ESI-3",
    "i have fever": "ESI-3",
    "sore throat": "ESI-4",
    "mild earache": "ESI-4",
    "sprained ankle": "ESI-4",
    "runny nose": "ESI-5",
    "headache": "ESI-5",
    "prescription refill": "ESI-5"
  },

  "next_step_links": {
    "ED": "https://goo.gl/maps/PZ6q7CPz5vT2",
    "Outpatient": "https://www.mayoclinic.org/appointments",
    "Self-Care": "https://www.nhs.uk/live-well/"
  },

  "protocols": [
    {
      "id": "PROTO-STEMI",
      "title": "ST-Elevation Myocardial Infarction",
      "triggers": ["chest pain", "pressure", "radiation to arm/jaw", "diaphoresis"],
      "esi_default": "ESI-2",
      "override_rules": ["Hemodynamic instability → ESI-1"]
    },
    {
      "id": "PROTO-STROKE",
      "title": "Hyperacute Stroke",
      "triggers": ["weakness", "speech difficulty", "facial droop"],
      "esi_default": "ESI-2",
      "override_rules": ["Airway compromise → ESI-1"]
    },
    {
      "id": "PROTO-FEVER",
      "title": "Fever & Infection",
      "triggers": ["fever", "chills", "infection"],
      "esi_default": "ESI-3",
      "override_rules": ["Fever <3 months → ESI-2"]
    },
    {
      "id": "PROTO-MINOR",
      "title": "Minor Injuries / Outpatient",
      "triggers": ["sprain", "ankle", "mild earache", "sore throat"],
      "esi_default": "ESI-4"
    },
    {
      "id": "PROTO-ADVICE",
      "title": "Self-Care & Advice",
      "triggers": ["runny nose", "headache", "prescription refill"],
      "esi_default": "ESI-5"
    }
  ],

  "examples": {
    "ED": ["pain in my heart", "i lost my hand", "i cant walk", "shortness of breath"],
    "Outpatient": ["i have fever", "sprained ankle", "mild earache"],
    "Self-Care": ["runny nose", "prescription refill", "tension headache"]
  }
}
